# Copy to .env and fill in real values. .env is gitignored — never commit it.
# In GitHub Actions, set these as repository secrets instead of using a file.

# Global Forest Watch Data API key — https://www.globalforestwatch.org/ (Data API)
GFW_API_KEY=

# NASA FIRMS API key — https://firms.modis.gov/api/ (used by fetch_fire.py)
FIRMS_API_KEY=

# --- Literature Assistant (see worker/README.md) ---
# Optional but recommended: free OpenAlex key (https://openalex.org/settings/api).
# Used by build_rag_corpus.py; the keyless budget is small and shared per IP.
OPENALEX_API_KEY=
# Cloudflare account ID (shared with fetch_cloudflare_analytics.py)
CF_ACCOUNT_ID=
# Separate scoped token for ingest_rag.py: "Workers AI: Read" + "Vectorize: Edit"
CF_RAG_API_TOKEN=
# Library: normally only used by the nightly GitHub Action (repo secrets), but
# set these to run sync_drive_library.py locally. The JSON value is the whole
# service account key file on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_FOLDER_ID=
CATALOG_SHEET_ID=
# Optional local test folder for catalog_library.py / build_rag_corpus.py
LIBRARY_DIR=
